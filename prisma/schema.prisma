generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")  
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  category  String
  media     String
  text      String
  upcoming  Boolean
  english   Boolean
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean?
}

model Podcast {
  id          String   @id @default(uuid())
  title       String
  description String?
  audioPath   String
  imagePath   String?
  category    String?
  english     Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imagePrompt String?
  textPrompt  String
  deleted     Boolean  @default(false)
  voiceType   String?
  published   Boolean  @default(false)
}

model UsedImages {
  id           String   @id @default(uuid())
  podcastTitle String?
  imagePath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?
}

model UsedPodcasts {
  id           String   @id @default(uuid())
  podcastTitle String?
  audioPath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?
}

model VisitorsCounter {
  id        String   @id @default(uuid())
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  password             String?
  role                 Role                   @default(CLIENT)
  emailVerified        DateTime?
  image                String?
  lastLoggedIn         DateTime?
  loginCount           Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  active               Boolean                @default(true)
  deletedAt            DateTime?
  firstName            String?
  lastName             String?
  phoneNumber          String?                @map("phone_number") @db.VarChar(20)
  organization         String?
  isFleetManager       Boolean                @default(false)
  loginProvider        String?
  hybridPassword       String?
  vehicles             MyVehicle[]
  vehicleExpenses      MyVehicleExpense[]
  vehicleMileage       MyVehicleMileage[]
  vehicleNotifications VehicleNotification[]
}

model VehicleNotification {
  id                   Int        @id @default(autoincrement())
  company              String?    @db.VarChar(100)
  personName           String?    @db.VarChar(100)
  email                String?    @db.VarChar(150)
  phoneNumber          String?    @db.VarChar(150)
  vehicleRegistration  String?    @db.VarChar(20)
  vehicleType          String?    @db.VarChar(100)
  notificationType     String?    @db.VarChar(50)
  notificationChannel  String?    @db.VarChar(50)
  notificationDate     DateTime?
  dutyDate             DateTime?
  emailMessage         String?
  status               String     @default("pending") @db.VarChar(20)
  emailSentAt          DateTime?
  smsSentAt            DateTime?
  createdAt            DateTime   @default(now())
  sheetRowId           String?    @unique @db.VarChar(50)
  confirmationToken    String?    @unique @map("confirmation_token") @db.VarChar(64)
  tokenExpiresAt       DateTime?  @map("token_expires_at")
  confirmationAttempts Int        @default(0)
  confirmedAt          DateTime?
  lastReminderSent     DateTime?
  finalStatusUpdated   DateTime?
  deletedAt            DateTime?  @map("deleted_at")
  userId               String?    @map("user_id")
  user                 User?      @relation(fields: [userId], references: [id])
  myVehicleId          String?    @map("my_vehicle_id")
  myVehicle            MyVehicle? @relation(fields: [myVehicleId], references: [id])

  @@index([userId])
  @@index([myVehicleId])
  @@map("vehiclenotification")
}

model BotLog {
  id               String   @id @default(uuid())
  name             String?
  email            String?
  phone            String?
  message          String?
  honeypot         String?
  userAgent        String?
  ipAddress        String?
  timeSpent        Int?
  detectionType    String
  detectionDetails String?
  locale           String?
  origin           String?
  createdAt        DateTime @default(now())
}

model IPReputation {
  id               String    @id @default(uuid())
  ipAddress        String    @unique
  violations       Int       @default(0)
  firstSeen        DateTime  @default(now())
  lastSeen         DateTime  @updatedAt
  bannedUntil      DateTime?
  isPermanentBan   Boolean   @default(false)
  detectionHistory Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("ip_reputations")
}

model ConfirmationLog {
  id             Int      @id @default(autoincrement())
  notificationId Int      @map("notification_id")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  timestamp      DateTime @default(now())

  @@index([notificationId])
  @@map("confirmation_log")
}

model MyVehicle {
  id                    String                 @id @default(uuid())
  organization          String                 @db.VarChar(100)
  type                  String                 @db.VarChar(100)
  registration          String                 @db.VarChar(20)
  year                  Int?
  image                 String?
  note                  String?                @db.Text
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  userId                String                 @map("user_id")
  user                  User                   @relation(fields: [userId], references: [id])
  expenses              MyVehicleExpense[]
  mileageRecords        MyVehicleMileage[]
  vehicleNotifications  VehicleNotification[]

  @@index([userId])
  @@map("my_vehicles")
}

model MyVehicleExpense {
  id           String     @id @default(uuid())
  vehicleId    String     @map("vehicle_id")
  vehicle      MyVehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  organization String     @db.VarChar(100)
  item         String     @db.VarChar(200)
  cost         Decimal    @db.Decimal(10, 2)
  date         DateTime
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])

  @@index([vehicleId])
  @@index([userId])
  @@map("my_vehicle_expenses")
}

model MyVehicleMileage {
  id         String     @id @default(uuid())
  vehicleId  String     @map("vehicle_id")
  vehicle    MyVehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kilometers Int
  date       DateTime
  note       String?    @db.Text
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id])

  @@index([vehicleId])
  @@index([userId])
  @@map("my_vehicle_mileage")
}

enum Role {
  ADMIN
  CLIENT
}

enum Tier {
  FREE
  PREMIUM
}

model Organization {
  id                        String         @id @default(uuid())
  name                      String         @db.VarChar(100)
  mainContact               String?        @map("main_contact") @db.VarChar(100)
  tier                      Tier?
  numberUsers               Int?           @map("number_users")
  numberVehicles            Int?           @map("number_vehicles")
  numberNotificationTypes   Int?           @map("number_notification_types")
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")
  deletedAt                 DateTime?      @map("deleted_at")
  parentOrganizationId      String?        @map("parent_organization_id")
  parentOrganization        Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations        Organization[] @relation("OrganizationHierarchy")

  @@index([parentOrganizationId])
  @@map("organizations")
}

model NotificationTemplate {
  id                    String   @id @default(uuid())
  organization          String   @db.VarChar(100)
  name                  String   @db.VarChar(100)
  notificationType      String   @db.VarChar(50)
  notificationChannel   String   @db.VarChar(50)
  daysBeforeDuty        Int?
  emailMessage          String?  @db.Text
  smsMessage            String?  @db.Text
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([organization])
  @@map("notification_templates")
}

model NotificationTypeOption {
  id           String   @id @default(uuid())
  organization String   @db.VarChar(100)
  label        String   @db.VarChar(100)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([organization])
  @@map("notification_type_options")
}

model NotificationChannelOption {
  id           String   @id @default(uuid())
  organization String   @db.VarChar(100)
  label        String   @db.VarChar(50)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([organization])
  @@map("notification_channel_options")
}
