generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")  
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  category  String
  media     String
  text      String
  upcoming  Boolean
  english   Boolean
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean?
}

model Podcast {
  id          String   @id @default(uuid())
  title       String
  description String?
  audioPath   String
  imagePath   String?
  category    String?
  english     Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imagePrompt String?
  textPrompt  String
  deleted     Boolean  @default(false)
  voiceType   String?
  published   Boolean  @default(false)
}

model UsedImages {
  id           String   @id @default(uuid())
  podcastTitle String?
  imagePath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?
}

model UsedPodcasts {
  id           String   @id @default(uuid())
  podcastTitle String?
  audioPath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?
}

model VisitorsCounter {
  id        String   @id @default(uuid())
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String?
  name           String?
  role           Role      @default(CLIENT)
  tier           Tier      @default(FREE)
  emailVerified  DateTime?
  image          String?
  lastLoggedIn   DateTime?
  loginCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  active         Boolean   @default(true)
  deletedAt      DateTime?
  firstName      String?
  lastName       String?
  organization   String?
  isFleetManager Boolean   @default(false)
  loginProvider  String?
  hybridPassword String?
}

model VehicleNotification {
  id                   Int       @id @default(autoincrement())
  company              String?   @db.VarChar(100)
  personName           String?   @db.VarChar(100)
  email                String?   @db.VarChar(150)
  phoneNumber          String?   @db.VarChar(150)
  vehicleRegistration  String?   @db.VarChar(20)
  vehicleType          String?   @db.VarChar(100)
  notificationType     String?   @db.VarChar(50)
  notificationChannel  String?   @db.VarChar(50)
  notificationDate     DateTime?
  dutyDate             DateTime?
  emailMessage         String?
  status               String    @default("pending") @db.VarChar(20)
  emailSentAt          DateTime?
  smsSentAt            DateTime?
  createdAt            DateTime  @default(now())
  sheetRowId           String?   @unique @db.VarChar(50)
  confirmationToken    String?   @unique @map("confirmation_token") @db.VarChar(64)
  tokenExpiresAt       DateTime? @map("token_expires_at")
  confirmationAttempts Int       @default(0)
  confirmedAt          DateTime?
  lastReminderSent     DateTime?
  finalStatusUpdated   DateTime?

  @@map("vehiclenotification")
}

model BotLog {
  id               String   @id @default(uuid())
  name             String?
  email            String?
  phone            String?
  message          String?
  honeypot         String?
  userAgent        String?
  ipAddress        String?
  timeSpent        Int?
  detectionType    String
  detectionDetails String?
  locale           String?
  origin           String?
  createdAt        DateTime @default(now())
}

model IPReputation {
  id               String    @id @default(uuid())
  ipAddress        String    @unique
  violations       Int       @default(0)
  firstSeen        DateTime  @default(now())
  lastSeen         DateTime  @updatedAt
  bannedUntil      DateTime?
  isPermanentBan   Boolean   @default(false)
  detectionHistory Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("ip_reputations")
}

model ConfirmationLog {
  id             Int      @id @default(autoincrement())
  notificationId Int      @map("notification_id")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  timestamp      DateTime @default(now())

  @@index([notificationId])
  @@map("confirmation_log")
}

enum Role {
  ADMIN
  CLIENT
}

enum Tier {
  FREE
  PREMIUM
}
