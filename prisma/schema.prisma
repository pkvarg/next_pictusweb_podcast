generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  category  String
  media     String
  text      String
  upcoming  Boolean
  english   Boolean
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean?

  @@map("blogs")
}

model Podcast {
  id          String   @id @default(uuid())
  title       String
  description String?
  audioPath   String
  imagePath   String?
  category    String?
  english     Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imagePrompt String?
  textPrompt  String
  deleted     Boolean  @default(false)
  voiceType   String?
  published   Boolean  @default(false)

  @@map("podcasts")
}

model UsedImages {
  id           String   @id @default(uuid())
  podcastTitle String?
  imagePath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?

  @@map("used_images")
}

model UsedPodcasts {
  id           String   @id @default(uuid())
  podcastTitle String?
  audioPath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?

  @@map("used_podcasts")
}

model VisitorsCounter {
  id        String   @id @default(uuid())
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("visitors_counters")
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  password             String?
  role                 Role          @default(CLIENT)
  emailVerified        DateTime?
  image                String?
  lastLoggedIn         DateTime?
  loginCount           Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  active               Boolean       @default(true)
  deletedAt            DateTime?
  firstName            String?
  lastName             String?
  phoneNumber          String?       @map("phone_number") @db.VarChar(20)
  organizationId       String?       @map("organization_id")
  organizationRelation Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  isFleetManager       Boolean       @default(false)
  loginProvider        String?

  // CarCare notification preferences
  timezone         String    @default("Europe/Bratislava")
  quietHoursStart  Int?      @map("quiet_hours_start")
  quietHoursEnd    Int?      @map("quiet_hours_end")
  channelOptIns    Channel[] @map("channel_opt_ins")
  smsMonthlyLimit  Int       @default(20) @map("sms_monthly_limit")
  smsSentThisMonth Int       @default(0) @map("sms_sent_this_month")

  phoneVerified          DateTime? @map("phone_verified")
  // Benefit fields
  isBenefit              Boolean   @default(false) @map("is_benefit")
  benefitParentOrgId     String?   @map("benefit_parent_org_id") @db.Uuid
  benefitGdprAccepted    Boolean   @default(false) @map("benefit_gdpr_accepted")
  benefitGdprAcceptedAt  DateTime? @map("benefit_gdpr_accepted_at")
  benefitTermsAccepted   Boolean   @default(false) @map("benefit_terms_accepted")
  benefitTermsAcceptedAt DateTime? @map("benefit_terms_accepted_at")
  benefitActivationToken String?   @unique @map("benefit_activation_token")

  vehicles               MyVehicle[]
  vehicleExpenses        MyVehicleExpense[]
  vehicleMileage         MyVehicleMileage[]
  vehicleNotifications   VehicleNotification[]
  picDocsRuns            PicDocsRun[]
  responsibleEvents      RecurringEvent[]
  notificationDeliveries NotificationDelivery[]
  notificationRecipient  NotificationRecipient[]
  recipientExclusions    EventRecipientExclusion[]
  garageMemberships      GarageMembership[]
  pushSubscriptions      PushSubscription[]

  @@map("users")
}

model VehicleNotification {
  id                   Int           @id @default(autoincrement())
  dutyBatchId          String?       @map("duty_batch_id") @db.VarChar(50)
  isPdr                Boolean       @default(false) @map("is_pdr")
  pdrReminderFor       String?       @map("pdr_reminder_for") @db.VarChar(50) // For PDR reminder: which batch it reminds about
  renewedFromBatchId   String?       @map("renewed_from_batch_id") @db.VarChar(50) // Tracks renewal lineage
  isAggressiveMode     Boolean       @default(false) @map("is_aggressive_mode")
  aggressiveStart      DateTime?     @map("aggressive_start")
  aggressiveEnd        DateTime?     @map("aggressive_end")
  aggressiveDaysSent   Int           @default(0) @map("aggressive_days_sent")
  organizationId       String?       @map("organization_id") // TEXT to match organizations.id
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  personName           String?       @db.VarChar(100)
  email                String?       @db.VarChar(150)
  phoneNumber          String?       @db.VarChar(150)
  vehicleRegistration  String?       @db.VarChar(20)
  notificationType     String?       @db.VarChar(50)
  notificationChannel  String?       @db.VarChar(50)
  notificationDate     DateTime?
  dutyDate             DateTime?
  emailMessage         String?
  status               String        @default("pending") @db.VarChar(20)
  emailSentAt          DateTime?
  smsSentAt            DateTime?
  createdAt            DateTime      @default(now())
  confirmationToken    String?       @unique @map("confirmation_token") @db.VarChar(64)
  tokenExpiresAt       DateTime?     @map("token_expires_at")
  confirmationAttempts Int           @default(0)
  confirmedAt          DateTime?
  lastReminderSent     DateTime?
  finalStatusUpdated   DateTime?
  deletedAt            DateTime?     @map("deleted_at")
  userId               String?       @map("user_id")
  user                 User?         @relation(fields: [userId], references: [id])
  myVehicleId          String?       @map("my_vehicle_id")
  myVehicle            MyVehicle?    @relation(fields: [myVehicleId], references: [id])

  @@index([userId])
  @@index([myVehicleId])
  @@index([dutyBatchId])
  @@index([isPdr])
  @@index([pdrReminderFor])
  @@index([renewedFromBatchId])
  @@index([isAggressiveMode])
  @@index([organizationId])
  @@map("vehicle_notifications")
}

model BotLog {
  id               String   @id @default(uuid())
  name             String?
  email            String?
  phone            String?
  message          String?
  honeypot         String?
  userAgent        String?
  ipAddress        String?
  timeSpent        Int?
  detectionType    String
  detectionDetails String?
  locale           String?
  origin           String?
  createdAt        DateTime @default(now())

  @@map("bot_logs")
}

model ContactLog {
  id             String   @id @default(uuid())
  name           String?
  email          String?
  phone          String?
  message        String?
  subject        String?
  locale         String?
  origin         String?
  ipAddress      String?
  userAgent      String?
  referer        String?
  acceptLanguage String?
  timeSpent      Int?
  emailSent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("contact_logs")
}

model IPReputation {
  id               String    @id @default(uuid())
  ipAddress        String    @unique
  violations       Int       @default(0)
  firstSeen        DateTime  @default(now())
  lastSeen         DateTime  @updatedAt
  bannedUntil      DateTime?
  isPermanentBan   Boolean   @default(false)
  detectionHistory Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("ip_reputations")
}

model ConfirmationLog {
  id             Int      @id @default(autoincrement())
  notificationId Int      @map("notification_id")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  timestamp      DateTime @default(now())

  @@index([notificationId])
  @@map("confirmation_logs")
}

model MyVehicle {
  id                   String                @id @default(uuid())
  organizationId       String                @map("organization_id")
  organizationRelation Organization          @relation(fields: [organizationId], references: [id])
  type                 String                @db.VarChar(100)
  registration         String                @db.VarChar(20)
  nickname             String?               @db.VarChar(100)
  make                 String?               @db.VarChar(60)
  model                String?               @db.VarChar(60)
  powertrain           Powertrain?
  country              String?               @db.VarChar(2)
  vin                  String?               @db.VarChar(20)
  year                 Int?
  image                String?
  note                 String?               @db.Text
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  userId               String                @map("user_id")
  user                 User                  @relation(fields: [userId], references: [id])
  expenses             MyVehicleExpense[]
  mileageRecords       MyVehicleMileage[]
  vehicleNotifications VehicleNotification[]
  recurringEvents      RecurringEvent[]
  eventOccurrences     EventOccurrence[]
  vehicleAccess        VehicleAccess[]

  @@index([userId])
  @@index([organizationId])
  @@map("my_vehicles")
}

model MyVehicleExpense {
  id                   String       @id @default(uuid())
  vehicleId            String       @map("vehicle_id")
  vehicle              MyVehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  organizationId       String       @map("organization_id")
  organizationRelation Organization @relation(fields: [organizationId], references: [id])
  item                 String       @db.VarChar(200)
  cost                 Decimal      @db.Decimal(10, 2)
  date                 DateTime
  note                 String?      @db.VarChar(500)
  link                 String?      @db.VarChar(500)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")
  userId               String       @map("user_id")
  user                 User         @relation(fields: [userId], references: [id])

  @@index([vehicleId])
  @@index([userId])
  @@index([organizationId])
  @@map("my_vehicle_expenses")
}

model MyVehicleMileage {
  id                   String       @id @default(uuid())
  vehicleId            String       @map("vehicle_id")
  vehicle              MyVehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  organizationId       String       @map("organization_id")
  organizationRelation Organization @relation(fields: [organizationId], references: [id])
  kilometers           Int
  date                 DateTime
  note                 String?      @db.Text
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")
  userId               String       @map("user_id")
  user                 User         @relation(fields: [userId], references: [id])

  @@index([vehicleId])
  @@index([userId])
  @@index([organizationId])
  @@map("my_vehicle_mileages")
}

enum Role {
  ADMIN
  CLIENT
}

enum Product {
  FLEETSYNC
  PICDOCS
}

model Tier {
  id                     String    @id @default(uuid())
  name                   String    @unique @db.VarChar(50)
  usersLimit             Int       @map("users_limit")
  vehiclesLimit          Int       @map("vehicles_limit")
  notificationsLimit     Int       @map("notifications_limit")
  // Yearly notification allowance granted per vehicle (0 = use the flat notificationsLimit,
  // e.g. the FREE trial). BASIC/BUSINESS use this × the org's vehicle count.
  notificationsPerVehicle Int      @default(0) @map("notifications_per_vehicle")
  pricePerVehicle        Decimal?  @map("price_per_vehicle") @db.Decimal(10, 2)
  pricePerVehicleYearly  Decimal?  @map("price_per_vehicle_yearly") @db.Decimal(10, 2)
  yearlyDiscount         Decimal?  @map("yearly_discount") @db.Decimal(4, 2)
  stripePriceMonthly     String?   @map("stripe_price_monthly") @db.VarChar(100)
  stripePriceYearly      String?   @map("stripe_price_yearly") @db.VarChar(100)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  // Note: This relation field is required by Prisma ORM for querying.
  // It does NOT create a database column - only Organization has tier_id FK.
  organizations      Organization[]
  pendingOnboardings PendingOnboarding[]

  @@map("tiers")
}

model Organization {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  mainContact String? @map("main_contact") @db.VarChar(100)

  // Which product this organization uses (FleetSync by default so existing orgs are untouched)
  product Product @default(FLEETSYNC)

  // Tier reference
  tierId       String? @map("tier_id")
  tierRelation Tier?   @relation(fields: [tierId], references: [id])

  // Live tracking columns (count of rows with deletedAt = NULL)
  currentUsersCount             Int @default(0) @map("current_users_count")
  currentVehiclesCount          Int @default(0) @map("current_vehicles_count")
  currentNotificationsCount     Int @default(0) @map("current_notifications_count")
  // Org's total yearly notification allowance (tier rate × vehicles, or the flat trial),
  // refreshed by the limit check. currentNotificationsCount is the spend against it.
  notificationsAllowance        Int @default(0) @map("notifications_allowance")

  // Notification usage tracking
  notificationPeriodStart DateTime? @map("notification_period_start")
  notificationsBlocked    Boolean   @default(false) @map("notifications_blocked")

  // Org-level limit overrides (fallback to tier if null)
  usersLimit             Int?    @map("users_limit")
  vehiclesLimit          Int?    @map("vehicles_limit")
  notificationsLimit     Int?    @map("notifications_limit")
  purchasedVehicles      Int?    @map("purchased_vehicles")
  hiddenFromPictusaci    Boolean @default(false) @map("hidden_from_pictusaci")

  // Stripe billing
  stripeCustomerId         String?   @unique @map("stripe_customer_id") @db.VarChar(100)
  stripeSubscriptionId     String?   @unique @map("stripe_subscription_id") @db.VarChar(100)
  stripeSubscriptionStatus String?   @map("stripe_subscription_status") @db.VarChar(30)
  billingInterval          String?   @map("billing_interval") @db.VarChar(10)
  subscriptionStartDate    DateTime? @map("subscription_start_date")
  subscriptionEndDate      DateTime? @map("subscription_end_date")

  // Upgrade & free trial
  pendingTierId       String?   @map("pending_tier_id")
  pendingTierStartsAt DateTime? @map("pending_tier_starts_at")
  freeTrialEndDate    DateTime? @map("free_trial_end_date")
  freeTrialTierId     String?   @map("free_trial_tier_id")

  // Invoicing / business identification
  ico        String? @db.VarChar(20)
  dic        String? @db.VarChar(20)
  street     String? @db.VarChar(200)
  city       String? @db.VarChar(100)
  postalCode String? @map("postal_code") @db.VarChar(20)
  country    String? @db.VarChar(100)

  // Onboarding
  onboardedBy    String?   @map("onboarded_by") @db.VarChar(255)
  agentConsentBy String?   @map("agent_consent_by") @db.VarChar(255)
  agentConsentAt DateTime? @map("agent_consent_at")

  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")
  parentOrganizationId String?        @map("parent_organization_id")
  parentOrganization   Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations   Organization[] @relation("OrganizationHierarchy")

  // Benefit
  isBenefitOrg     Boolean @default(false) @map("is_benefit_org")
  canCreateBenefit Boolean @default(false) @map("can_create_benefit")

  // Newsletter
  newsletterOptOut            Boolean @default(false) @map("newsletter_opt_out")
  useCustomTemplates          Boolean @default(false) @map("use_custom_templates")
  confirmNotificationCreation Boolean @default(false) @map("confirm_notification_creation")

  // CarCare: account-level time of day reminders are sent (minute is 0 or 30).
  notificationSendHour   Int @default(8) @map("notification_send_hour")
  notificationSendMinute Int @default(30) @map("notification_send_minute")

  // CarCare: account-level language for notification content (sk | en | hu).
  notificationLocale String @default("sk") @map("notification_locale")
  bonusBusinessDashboards     Boolean @default(false) @map("bonus_business_dashboards")
  manuallyPaid                Boolean @default(false) @map("manually_paid")

  // Relations
  users                      User[]
  vehicles                   MyVehicle[]
  expenses                   MyVehicleExpense[]
  mileageRecords             MyVehicleMileage[]
  notificationChannelOptions NotificationChannelOption[]
  vehicleNotifications       VehicleNotification[]
  dutyRenewalPresets         DutyRenewalPreset[]

  // PicDocs (only populated when product = PICDOCS)
  picDocsOrg  PicDocsOrg?
  picDocsRuns PicDocsRun[]

  // CarCare event engine
  recurringEvents        RecurringEvent[]
  providers              Provider[]
  notificationRules      NotificationRule[]
  notificationRecipients NotificationRecipient[]
  garageMemberships      GarageMembership[]
  garageInvitations      GarageInvitation[]

  @@index([tierId])
  @@index([parentOrganizationId])
  @@map("organizations")
}

model NotificationChannelOption {
  id                   String       @id @default(uuid())
  organizationId       String       @map("organization_id")
  organizationRelation Organization @relation(fields: [organizationId], references: [id])
  label                String       @db.VarChar(50)
  isActive             Boolean      @default(true)
  sortOrder            Int          @default(0)
  createdAt            DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("notification_channel_options")
}

model DutyRenewalPreset {
  id                    String       @id @default(uuid())
  notificationTypeId    String?      @map("notification_type_id")
  notificationTypeLabel String?      @map("notification_type_label") @db.VarChar(50)
  organizationId        String       @map("organization_id")
  organizationRelation  Organization @relation(fields: [organizationId], references: [id])

  // Preset options - stored as comma-separated or JSON
  presetMonths       String @map("preset_months") @db.VarChar(100) // e.g., "6,12,24"
  presetLabels       String @map("preset_labels") @db.VarChar(255) // e.g., "+6 mesiacov,+1 rok,+2 roky"
  defaultPresetIndex Int    @default(0) @map("default_preset_index")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([notificationTypeId])
  @@map("duty_renewal_presets")
}

model VerificationCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  purpose   String    @db.VarChar(30)
  codeHash  String    @map("code_hash") @db.VarChar(64)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([purpose])
  @@map("verification_codes")
}

model TrustedDevice {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  deviceHash String   @map("device_hash") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([deviceHash])
  @@map("trusted_devices")
}

model PendingOnboarding {
  id                  String    @id @default(uuid())
  organizationName    String    @map("organization_name") @db.VarChar(100)
  organizationContact String?   @map("organization_contact") @db.VarChar(100)
  tierId              String    @map("tier_id")
  tier                Tier      @relation(fields: [tierId], references: [id])
  purchasedVehicles   Int       @default(1) @map("purchased_vehicles")
  billingInterval     String    @map("billing_interval") @db.VarChar(10)
  firstName           String    @map("first_name") @db.VarChar(50)
  lastName            String    @map("last_name") @db.VarChar(50)
  email               String    @unique @db.VarChar(100)
  password            String
  phoneNumber         String?   @map("phone_number") @db.VarChar(20)
  ico                 String?   @db.VarChar(20)
  dic                 String?   @db.VarChar(20)
  street              String?   @db.VarChar(200)
  city                String?   @db.VarChar(100)
  postalCode          String?   @map("postal_code") @db.VarChar(20)
  country             String?   @db.VarChar(100)
  emailVerified       Boolean   @default(false) @map("email_verified")
  phoneVerified       Boolean   @default(false) @map("phone_verified")
  gdprAccepted        Boolean   @default(false) @map("gdpr_accepted")
  termsAccepted       Boolean   @default(false) @map("terms_accepted")
  gdprAcceptedAt      DateTime? @map("gdpr_accepted_at")
  termsAcceptedAt     DateTime? @map("terms_accepted_at")
  stripeSessionId     String?   @unique @map("stripe_session_id") @db.VarChar(200)
  createdAt           DateTime  @default(now()) @map("created_at")
  expiresAt           DateTime  @map("expires_at")

  @@map("pending_onboardings")
}

model Invoice {
  id               String    @id @default(uuid())
  invoiceNumber    String    @map("invoice_number") @db.VarChar(20)
  organizationName String    @map("organization_name") @db.VarChar(100)
  street           String?   @db.VarChar(200)
  city             String?   @db.VarChar(100)
  postalCode       String?   @map("postal_code") @db.VarChar(20)
  country          String?   @db.VarChar(100)
  ico              String?   @db.VarChar(20)
  dic              String?   @db.VarChar(20)
  firstName        String    @map("first_name") @db.VarChar(50)
  lastName         String    @map("last_name") @db.VarChar(50)
  email            String    @db.VarChar(100)
  tier             String    @db.VarChar(20)
  billing          String    @db.VarChar(10)
  numberOfVehicles Int       @map("number_of_vehicles")
  pricePerVehicle  Float     @map("price_per_vehicle")
  totalPrice       Float     @map("total_price")
  paymentType      String    @default("stripe") @map("payment_type") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")
  deletionReason   String?   @map("deletion_reason") @db.VarChar(500)

  @@index([invoiceNumber])
  @@map("invoices")
}

model PicDocsOrg {
  organizationId       String       @id @map("organization_id")
  organizationRelation Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dokladoApiKeyEnc      String? @map("doklado_api_key_enc")
  dokladoOrganizationId String  @map("doklado_organization_id") @db.VarChar(50)
  recipientEmail        String  @map("recipient_email") @db.VarChar(255)

  runsThisHour    Int       @default(0) @map("runs_this_hour")
  rateWindowStart DateTime? @map("rate_window_start")
  lastRunAt       DateTime? @map("last_run_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("picdocs_orgs")
}

model PicDocsRun {
  id                   String       @id @default(uuid())
  organizationId       String       @map("organization_id")
  organizationRelation Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String?      @map("user_id")
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  status               String       @db.VarChar(20)
  processedCount       Int          @default(0) @map("processed_count")
  flaggedCount         Int          @default(0) @map("flagged_count")
  errorMessage         String?      @map("error_message") @db.Text
  startedAt            DateTime     @default(now()) @map("started_at")
  finishedAt           DateTime?    @map("finished_at")

  @@index([organizationId])
  @@index([status])
  @@map("picdocs_runs")
}

// ============================================================================
// CarCare event engine — M2 (event schema) + M3 (providers & appointments)
// ============================================================================

enum RecurrenceType {
  ONE_TIME
  FIXED_INTERVAL
  AFTER_COMPLETION
  SEASONAL
  MILEAGE
  DATE_OR_MILEAGE
}

enum OccurrenceStatus {
  UPCOMING
  ACTION_REQUIRED
  ARRANGED
  COMPLETED
  SKIPPED
  CANCELLED
}

enum EventKind {
  LEGAL
  RECOMMENDED
}

enum ActionType {
  BOOK
  RENEW
  PAY
  PURCHASE
  INSPECT
  CUSTOM
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  MISSED
}

model EventTemplate {
  id              String           @id @default(uuid())
  key             String           @unique
  category        String           @db.VarChar(50)
  country         String?          @db.VarChar(2)
  powertrains     String[]
  kind            EventKind        @default(RECOMMENDED)
  actionType      ActionType       @default(BOOK) @map("action_type")
  recurrenceType  RecurrenceType   @map("recurrence_type")
  intervalMonths  Int?             @map("interval_months")
  intervalDays    Int?             @map("interval_days")
  intervalKm      Int?             @map("interval_km")
  seasonalMonth   Int?             @map("seasonal_month")
  seasonalDay     Int?             @map("seasonal_day")
  defaultLeadDays Int              @default(30) @map("default_lead_days")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  recurringEvents RecurringEvent[]

  @@index([country])
  @@map("event_templates")
}

model RecurringEvent {
  id                  String         @id @default(uuid())
  organizationId      String         @map("organization_id")
  vehicleId           String         @map("vehicle_id")
  templateId          String?        @map("template_id")
  name                String         @db.VarChar(120)
  category            String         @db.VarChar(50)
  kind                EventKind      @default(RECOMMENDED)
  actionType          ActionType     @default(BOOK) @map("action_type")
  recurrenceType      RecurrenceType @map("recurrence_type")
  intervalMonths      Int?           @map("interval_months")
  intervalDays        Int?           @map("interval_days")
  intervalKm          Int?           @map("interval_km")
  seasonalMonth       Int?           @map("seasonal_month")
  seasonalDay         Int?           @map("seasonal_day")
  anchorDate          DateTime?      @map("anchor_date")
  responsibleUserId   String?        @map("responsible_user_id")
  preferredProviderId String?        @map("preferred_provider_id")
  expectedCost        Decimal?       @map("expected_cost") @db.Decimal(10, 2)
  currency            String         @default("EUR") @db.VarChar(3)
  paused              Boolean        @default(false)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  organization      Organization           @relation(fields: [organizationId], references: [id])
  vehicle           MyVehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  template          EventTemplate?         @relation(fields: [templateId], references: [id])
  responsibleUser   User?                  @relation(fields: [responsibleUserId], references: [id])
  preferredProvider Provider?              @relation(fields: [preferredProviderId], references: [id], onDelete: SetNull)
  occurrences         EventOccurrence[]
  rules               NotificationRule[]
  deliveries          NotificationDelivery[]
  recipientExclusions EventRecipientExclusion[]

  @@index([organizationId])
  @@index([vehicleId])
  @@index([responsibleUserId])
  @@map("recurring_events")
}

model EventOccurrence {
  id                   String           @id @default(uuid())
  recurringEventId     String           @map("recurring_event_id")
  vehicleId            String           @map("vehicle_id")
  sequenceNo           Int              @map("sequence_no")
  generatedFromId      String?          @unique @map("generated_from_id")
  status               OccurrenceStatus @default(UPCOMING)
  dueDate              DateTime?        @map("due_date")
  dueMileage           Int?             @map("due_mileage")
  completedAt          DateTime?        @map("completed_at")
  completedMileage     Int?             @map("completed_mileage")
  completionProviderId String?          @map("completion_provider_id")
  actualCost           Decimal?         @map("actual_cost") @db.Decimal(10, 2)
  currency             String?          @db.VarChar(3)
  notes                String?          @db.Text
  skipReason           String?          @map("skip_reason")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  recurringEvent RecurringEvent         @relation(fields: [recurringEventId], references: [id], onDelete: Cascade)
  vehicle        MyVehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  deliveries     NotificationDelivery[]

  @@unique([recurringEventId, sequenceNo])
  @@index([status, dueDate])
  @@index([vehicleId])
  @@map("event_occurrences")
}

model Provider {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String    @db.VarChar(120)
  category       String?   @db.VarChar(50)
  phone          String?   @db.VarChar(40)
  email          String?   @db.VarChar(150)
  website        String?   @db.VarChar(255)
  bookingUrl     String?   @map("booking_url") @db.VarChar(255)
  address        String?   @db.VarChar(255)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization       Organization     @relation(fields: [organizationId], references: [id])
  appointments       Appointment[]
  preferredForEvents RecurringEvent[]

  @@index([organizationId])
  @@map("providers")
}

model Appointment {
  id               String            @id @default(uuid())
  occurrenceId     String            @map("occurrence_id")
  providerId       String?           @map("provider_id")
  scheduledAt      DateTime          @map("scheduled_at")
  status           AppointmentStatus @default(BOOKED)
  bookingReference String?           @map("booking_reference")
  estimatedCost    Decimal?          @map("estimated_cost") @db.Decimal(10, 2)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  occurrence EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  provider   Provider?       @relation(fields: [providerId], references: [id])

  @@index([occurrenceId])
  @@index([providerId])
  @@map("appointments")
}

// ============================================================================
// CarCare event engine — M4 (notifications schema)
// ============================================================================

enum NotificationStage {
  PREPARATION
  BOOKING
  BOOKING_FOLLOWUP
  APPOINTMENT
  DEADLINE
  OVERDUE
  COMPLETION
  LOGGING
}

enum Channel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum DeliveryStatus {
  SCHEDULED
  SENT
  FAILED
  SUPPRESSED
  CANCELLED
}

model NotificationRule {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  recurringEventId    String?           @map("recurring_event_id")
  stage               NotificationStage
  leadDays            Int               @default(0) @map("lead_days")
  channels            Channel[]
  repeatUntilActioned Boolean           @default(false) @map("repeat_until_actioned")
  repeatEveryDays     Int?              @map("repeat_every_days")
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  recurringEvent RecurringEvent? @relation(fields: [recurringEventId], references: [id], onDelete: Cascade)

  @@index([organizationId, stage])
  @@map("notification_rules")
}

// Central recipient list: garage members who receive notifications by default for every
// event in the org. When empty, delivery falls back to the event's responsible person
// (or the garage owner), preserving the pre-multi-recipient behaviour.
model NotificationRecipient {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("notification_recipients")
}

// Per-event opt-out: a user in the central recipient list (or the responsible person)
// who should NOT be notified for this specific event.
model EventRecipientExclusion {
  id               String   @id @default(uuid())
  recurringEventId String   @map("recurring_event_id")
  userId           String   @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  recurringEvent RecurringEvent @relation(fields: [recurringEventId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recurringEventId, userId])
  @@index([recurringEventId])
  @@map("event_recipient_exclusions")
}

model NotificationDelivery {
  id               String            @id @default(uuid())
  occurrenceId     String            @map("occurrence_id")
  recurringEventId String            @map("recurring_event_id")
  stage            NotificationStage
  channel          Channel
  recipientUserId  String            @map("recipient_user_id")
  scheduledFor     DateTime          @map("scheduled_for")
  status           DeliveryStatus    @default(SCHEDULED)
  attempts         Int               @default(0)
  lastError        String?           @map("last_error")
  sentAt           DateTime?         @map("sent_at")
  readAt           DateTime?         @map("read_at")
  suppressedReason String?           @map("suppressed_reason")
  dedupeKey        String            @unique @map("dedupe_key")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  occurrence     EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  recurringEvent RecurringEvent  @relation(fields: [recurringEventId], references: [id], onDelete: Cascade)
  recipient      User            @relation(fields: [recipientUserId], references: [id])

  @@index([status, scheduledFor])
  @@index([occurrenceId, stage])
  @@index([recipientUserId, channel, status])
  @@map("notification_deliveries")
}

// ============================================================================
// CarCare — M11 (garage sharing, roles, invitations)
// ============================================================================

enum GarageRole {
  OWNER
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model GarageMembership {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  userId         String     @map("user_id")
  role           GarageRole @default(MEMBER)
  createdAt      DateTime   @default(now()) @map("created_at")

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleAccess VehicleAccess[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("garage_memberships")
}

model VehicleAccess {
  id           String @id @default(uuid())
  membershipId String @map("membership_id")
  vehicleId    String @map("vehicle_id")

  membership GarageMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  vehicle    MyVehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, vehicleId])
  @@index([vehicleId])
  @@map("vehicle_access")
}

model GarageInvitation {
  id              String           @id @default(uuid())
  organizationId  String           @map("organization_id")
  email           String
  role            GarageRole       @default(MEMBER)
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at")
  invitedByUserId String?          @map("invited_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("garage_invitations")
}

// ============================================================================
// CarCare — M12 (vehicle powertrain + make/model catalogue)
// ============================================================================

enum Powertrain {
  PETROL
  DIESEL
  MHEV
  HEV
  PHEV
  BEV
  LPG
  CNG
  HYDROGEN
  OTHER
}

model VehicleCatalogueEntry {
  id         String      @id @default(uuid())
  make       String      @db.VarChar(60)
  model      String      @db.VarChar(60)
  powertrain Powertrain?
  yearFrom   Int?        @map("year_from")
  yearTo     Int?        @map("year_to")

  @@unique([make, model, powertrain])
  @@index([make])
  @@map("vehicle_catalogue")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}
