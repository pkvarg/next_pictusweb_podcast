generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  category  String
  media     String
  text      String
  upcoming  Boolean
  english   Boolean
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean?
}

model Podcast {
  id          String   @id @default(uuid())
  title       String
  description String?
  audioPath   String
  imagePath   String?
  category    String?
  english     Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imagePrompt String?
  textPrompt  String
  deleted     Boolean  @default(false)
  voiceType   String?
  published   Boolean  @default(false)
}

model UsedImages {
  id           String   @id @default(uuid())
  podcastTitle String?
  imagePath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?
}

model UsedPodcasts {
  id           String   @id @default(uuid())
  podcastTitle String?
  audioPath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?
}

model VisitorsCounter {
  id        String   @id @default(uuid())
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  loginProvider String?
  name          String?
  firstName     String?
  lastName      String?
  organization  String?
  active        Boolean   @default(true)
  role          Role      @default(CLIENT)
  tier          Tier      @default(FREE)
  emailVerified DateTime?
  image         String?
  lastLoggedIn  DateTime?
  loginCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}


enum Role {
  ADMIN
  CLIENT
}

enum Tier {
  FREE
  PREMIUM
}
