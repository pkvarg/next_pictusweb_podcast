generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  category  String
  media     String
  text      String
  upcoming  Boolean
  english   Boolean
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean?
}

model Podcast {
  id          String   @id @default(uuid())
  title       String
  description String?
  audioPath   String
  imagePath   String?
  category    String?
  english     Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imagePrompt String?
  textPrompt  String
  deleted     Boolean  @default(false)
  voiceType   String?
  published   Boolean  @default(false)
}

model UsedImages {
  id           String   @id @default(uuid())
  podcastTitle String?
  imagePath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?
}

model UsedPodcasts {
  id           String   @id @default(uuid())
  podcastTitle String?
  audioPath    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reallyUsed   Boolean?
}

model VisitorsCounter {
  id        String   @id @default(uuid())
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  loginProvider String?
  name          String?
  firstName     String?
  lastName      String?
  organization  String?
  active        Boolean   @default(true)
  role          Role      @default(CLIENT)
  tier          Tier      @default(FREE)
  emailVerified DateTime?
  image         String?
  lastLoggedIn  DateTime?
  loginCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model VehicleNotification {
  id                    Int       @id @default(autoincrement())
  company               String?   @db.VarChar(100)
  personName            String?   @db.VarChar(100)
  email                 String?   @db.VarChar(150)
  vehicleRegistration   String?   @db.VarChar(20)
  vehicleType           String?   @db.VarChar(100)
  kilometers            Int?
  notificationType      String?   @db.VarChar(50)
  notificationChannel   String?   @db.VarChar(50)
  notificationDate      DateTime?
  dutyDate              DateTime?
  emailMessage          String?   @db.Text
  status                String    @default("pending") @db.VarChar(20)
  sentAt                DateTime?
  createdAt             DateTime  @default(now())
  sheetRowId            String?   @unique @db.VarChar(50)
  confirmationAttempts  Int       @default(0)
  confirmedAt           DateTime?
  lastReminderSent      DateTime?
  finalStatusUpdated    DateTime?

  @@map("vehiclenotification")
}


enum Role {
  ADMIN
  CLIENT
}

enum Tier {
  FREE
  PREMIUM
}
